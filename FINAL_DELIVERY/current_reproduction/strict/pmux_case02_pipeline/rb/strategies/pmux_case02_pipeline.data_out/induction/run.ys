verilog_defaults -add -D CHECK_OUTPUTS
read_verilog -sv ../../../partitions/pmux_case02_pipeline.data_out.sv
read_rtlil ../../../partitions/pmux_case02_pipeline.data_out.il
hierarchy -top miter; proc; chformal -cover -remove
async2sync
formalff -clk2ff -ff2anyinit gate.pmux_case02_pipeline.data_out
setundef -anyseq gate.pmux_case02_pipeline.data_out
flatten -wb; dffunmap; opt_expr -keepdc -undriven; opt_clean
sat -tempinduct -set-init-undef -set-def-formal -set-def-inputs -maxsteps 20 -timeout 180 -set-assumes -prove-asserts -show-public -dump_vcd trace.vcd miter
