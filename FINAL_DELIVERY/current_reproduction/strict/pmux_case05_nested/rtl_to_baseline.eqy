[gold]
read_rtlil rtl.normalized.il
[gate]
read_rtlil baseline.normalized.il
[script]
hierarchy -check -top pmux_case05_nested
clk2fflogic
check -assert
[match pmux_case05_nested]
nodefault
gold-match clk
gold-match rst
gold-match en
gold-match data_in
gold-match ctrl_in
gold-match data_out
[collect pmux_case05_nested]
group *
[strategy induction]
use sat
depth 20
timeout 180
