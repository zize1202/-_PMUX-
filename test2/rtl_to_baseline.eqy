[gold]
read_rtlil rtl.normalized.il
[gate]
read_rtlil baseline.normalized.il
[script]
hierarchy -check -top test2
clk2fflogic
check -assert
[match test2]
nodefault
gold-match clk
gold-match a
gold-match b
gold-match c
gold-match d
gold-match dataa
gold-match datab
gold-match datac
gold-match datad
gold-match out
[collect test2]
group *
[strategy induction]
use sat
depth 20
timeout 180
